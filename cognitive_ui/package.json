{
  "name": "dt4lc-ui",
  "private": true,
  "version": "0.5.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "node tests/e2e/run.mjs",
    "e2e:smoke": "node tests/e2e/run.mjs smoke",
    "e2e:workspace": "npm run e2e:workspace:guest && npm run e2e:workspace:fake && npm run e2e:workspace:member && npm run e2e:workspace:quota",
    "e2e:workspace:guest": "node tests/e2e/run.mjs workspace-empty workspace-messages workspace-composer workspace-analysis workspace-result workspace-conversations",
    "e2e:workspace:fake": "E2E_LLM=fake node tests/e2e/run.mjs workspace-running",
    "e2e:workspace:member": "E2E_DEV_ROLE=member node tests/e2e/run.mjs workspace-preparing",
    "e2e:workspace:quota": "E2E_GUEST_LIMIT=2 node tests/e2e/run.mjs workspace-quota",
    "e2e:capabilities": "npm run e2e:capabilities:offline && npm run e2e:capabilities:demo",
    "e2e:capabilities:offline": "E2E_DEV_ROLE=member E2E_LLM=none node tests/e2e/run.mjs capabilities-offline",
    "e2e:capabilities:demo": "E2E_SERVER=demo E2E_LLM=fake E2E_GUEST_LIMIT=5 node tests/e2e/run.mjs capabilities-demo",
    "e2e:landing": "npm run e2e:landing:guest && npm run e2e:landing:member",
    "e2e:landing:guest": "E2E_GUEST_LIMIT=5 node tests/e2e/run.mjs landing",
    "e2e:landing:member": "E2E_DEV_ROLE=member node tests/e2e/run.mjs landing-member",
    "e2e:run2": "npm run e2e:capabilities && npm run e2e:landing"
  },
  "dependencies": {
    "@mapbox/mapbox-gl-draw": "^1.5.0",
    "@tanstack/react-query": "^5.90.2",
    "@turf/turf": "^7.2.0",
    "axios": "^1.12.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.544.0",
    "maplibre-gl": "^5.8.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-map-gl": "^8.0.4",
    "react-markdown": "10.1.0",
    "react-router-dom": "^7.9.3",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "^3.3.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@testing-library/react": "^16.3.3",
    "@types/mapbox__mapbox-gl-draw": "^1.4.9",
    "@types/node": "^22.13.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.12.0",
    "jsdom": "^26.1.0",
    "playwright-core": "1.64.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.15.0",
    "vite": "^6.0.1",
    "vitest": "^3.2.7"
  }
}
