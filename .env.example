# DT4LC Environment Configuration
# Copy this to .env and fill in values

# =============================================================================
# LLM Provider Selection
# =============================================================================
# Enable/disable specific providers (true/false)
LLM_ENABLE_GEMINI=true
LLM_ENABLE_GROQ=true
LLM_ENABLE_OLLAMA=true
LLM_ENABLE_APERTUS=false
LLM_ENABLE_ANTHROPIC=true
LLM_ENABLE_MISTRAL=true
LLM_ENABLE_OPENAI=true

# Provider priority order (comma-separated)
# Available: gemini, groq, ollama, apertus, anthropic, mistral, openai
# System tries providers in this order, falling back on failure.
# Commercial providers (anthropic, mistral, openai) activate only when both their
# API key is set AND they are listed here. Add them like:
#   LLM_PROVIDER_ORDER=anthropic,mistral,openai,gemini,groq,ollama
LLM_PROVIDER_ORDER=gemini,groq,ollama

# Routing strategy: fallback | cost | availability
# - fallback: Try in priority order, fall back on failure (default)
# - cost: Route to cheapest provider
# - availability: Route to first available
LLM_STRATEGY=fallback

# =============================================================================
# LLM API Keys (Optional - system falls back to Ollama if not set)
# =============================================================================

# Google Gemini (fast, free tier with limits)
# Get key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Gemini model selection (comma-separated for rotation)
# Use IDs that client.models.list() reports with generateContent, e.g.
#   gemini-3.5-flash-lite, gemini-3.5-flash, gemini-3.8-flash, gemini-2.5-flash
# gemini-2.0-flash / gemini-2.0-flash-exp are retired (404). One model is picked
# per process; if it answers 404, 429 (quota) or 503, the next ones in the list
# are tried in order, with a warning in the log.
# Single model: GEMINI_MODELS=gemini-3.5-flash-lite
# Multiple models: GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.8-flash
GEMINI_MODELS=gemini-3.5-flash-lite

# Groq (ultra-fast 300+ tokens/sec, free tier)
# Get key: https://console.groq.com/
GROQ_API_KEY=

# Groq model (single model - already ultra-fast, no rotation needed)
# Available: llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768
GROQ_MODEL=llama-3.3-70b-versatile

# =============================================================================
# Ollama Configuration
# =============================================================================
OLLAMA_MODEL=llama3.2
# Leave OLLAMA_BASE_URL unset under Docker: docker-compose.yml defaults it to
# http://ollama:11434. Bare-metal runs may set it to http://localhost:11434:
# OLLAMA_BASE_URL=http://localhost:11434

# =============================================================================
# Apertus Configuration (Swiss AI - Local HuggingFace Model)
# =============================================================================
# Apertus is disabled by default (requires GPU with significant VRAM)
# Enable only if you have the hardware:
# - 8B model: ~16GB VRAM
# - 70B model: ~140GB VRAM
APERTUS_ENABLED=false

# Model selection
# Available: swiss-ai/Apertus-8B, swiss-ai/Apertus-70B
APERTUS_MODEL=swiss-ai/Apertus-8B

# GPU device (0, 1, etc.) or "cpu" for CPU inference
APERTUS_DEVICE=0

# Data type: bfloat16 (default), float16, float32
APERTUS_DTYPE=bfloat16

# =============================================================================
# Anthropic Claude Configuration (Optional - commercial, BYO key)
# =============================================================================
# Get key: https://console.anthropic.com/
# Default is Sonnet 4.6 (good balance for orchestration). Override for
# different cost/capability trade-offs:
#   ANTHROPIC_MODELS=claude-opus-4-7    ($5/$25 per Mtok — most capable)
#   ANTHROPIC_MODELS=claude-haiku-4-5   ($1/$5 per Mtok — cheapest)
ANTHROPIC_API_KEY=

# Model selection (comma-separated for rotation across the same provider)
# Known IDs: claude-opus-4-7, claude-opus-4-6, claude-sonnet-4-6, claude-haiku-4-5
ANTHROPIC_MODELS=claude-sonnet-4-6

# =============================================================================
# Mistral AI Configuration (Optional - commercial, BYO key)
# =============================================================================
# Get key: https://console.mistral.ai/
# Mistral's API is OpenAI-compatible. Not to be confused with Groq's
# `mixtral-*` model family — that's a different company hosting Mistral's
# open-weight models.
MISTRAL_API_KEY=

# Model selection (comma-separated for rotation)
# Known IDs: mistral-large-latest, mistral-medium-latest, mistral-small-latest,
#            ministral-8b-latest, ministral-3b-latest, codestral-latest
MISTRAL_MODELS=mistral-medium-latest

# =============================================================================
# OpenAI Configuration (Optional - commercial, BYO key)
# =============================================================================
# Get key: https://platform.openai.com/api-keys
# GPT_SECRET is accepted as a fallback name when OPENAI_API_KEY is empty.
# Add `openai` to LLM_PROVIDER_ORDER to use it.
OPENAI_API_KEY=
# GPT_SECRET=

# Model selection (comma-separated for rotation). Default: gpt-4o-mini, the cheapest
# model that passes the planner tests.
# Reasoning models (o3, o4-mini, gpt-5, gpt-5-mini, gpt-5-nano, gpt-5.5+, gpt-6*)
# are sent without `temperature`, which they reject.
OPENAI_MODELS=gpt-4o-mini

# =============================================================================
# Google Earth Engine Configuration (Optional - for Sentinel-2 data fetching)
# =============================================================================
# Google Cloud Project ID with Earth Engine enabled
# Get started: https://developers.google.com/earth-engine/guides/python_install
# 1. Create a Google Cloud project
# 2. Enable Earth Engine API
# 3. Set up authentication (service account or gcloud)
GEE_PROJECT_ID=

# Optional: Service account key file path for GEE authentication
# If not set, will use default gcloud credentials
GEE_SERVICE_ACCOUNT_KEY=

# =============================================================================
# Job Storage Configuration
# =============================================================================
# Storage backend: sqlite (default, persistent) or memory (fast, lost on restart)
JOB_STORAGE=sqlite

# SQLite database path (only used when JOB_STORAGE=sqlite)
# DT4LC_JOBS_DB=resources/.cache/jobs.db

# =============================================================================
# Server Configuration
# =============================================================================
# Backend port (default: 8000)
BACKEND_PORT=8000

# Frontend port (default: 80)
FRONTEND_PORT=80

# What this installation is, for the Capabilities page summary line:
# demo (shown as "public demo") or local (default; not shown).
# DT4LC_DEPLOYMENT=local

# Origins allowed by CORS (comma-separated; default *). CORS sends no credentials,
# so a UI on another origin gets no session cookie: serve the UI and the API on
# one origin (nginx under Docker, the Vite dev proxy locally).
# CORS_ORIGINS=*

# Read by the dt4lc-api command (task run:api) only, not by uvicorn or the
# Docker image: listen address and port, hot reload, log level.
# DT4LC_HOST=0.0.0.0
# DT4LC_PORT=8000
# DT4LC_RELOAD=false
# DT4LC_LOG_LEVEL=info

# =============================================================================
# Storage paths
# =============================================================================
# Everything the server writes goes under the cache root, resources/.cache by
# default (relative paths are relative to the working directory). The other
# paths default to directories inside it. docker-compose.yml sets
# DT4LC_MODEL_CACHE, DT4LC_UPLOADS_PATH and DT4LC_JOBS_DB itself, inside the
# mounted ./resources. DT4LC_JOBS_DB is under "Job Storage Configuration" and
# DT4LC_SETTINGS_PATH under "Sessions, roles and guest limits".
# DT4LC_CACHE_PATH=resources/.cache
# Temporary and model output files (default <cache>/tmp)
# DT4LC_TEMP_PATH=resources/.cache/tmp
# Job output files, one directory per job (default <cache>/outputs)
# DT4LC_OUTPUTS_PATH=resources/.cache/outputs
# Uploaded GeoTIFFs, their previews and owner records (default <cache>/uploads)
# DT4LC_UPLOADS_PATH=resources/.cache/uploads
# Downloaded model weights (default <cache>/models)
# DT4LC_MODEL_CACHE=resources/.cache/models

# =============================================================================
# Sessions, roles and guest limits
# =============================================================================
# Every browser gets a signed, httpOnly session cookie (dt4lc_session). Visitors
# are guests; people on the allowlists below sign in with GitHub and become
# members or operators. Jobs and uploads belong to the guest session that made
# them, or to the signed-in user (github:<id>), who keeps a guest session's items
# on sign-in; operators see everything.

# Secret that signs the session cookie. If unset, a random one is generated at
# startup (with a warning) and every session resets when the server restarts.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
# SESSION_SECRET=

# Send the cookie only over HTTPS (true behind TLS; false for local http).
# SESSION_COOKIE_SECURE=false

# Developers: treat every request as this role (guest, member or operator),
# signed-in users included.
# member and operator have no analysis limit; operator also sees every job/upload.
# DEV_ROLE=member

# Analyses a guest may run per rolling hour, counted per session and per IP.
# GUEST_ANALYSES_PER_HOUR=5

# Hours a guest session lasts; guest jobs, their outputs and guest uploads older
# than this are removed by the hourly cleanup. Members' jobs are kept.
# GUEST_SESSION_HOURS=24

# Minutes between runs of that cleanup (default 60, at least 1).
# GUEST_CLEANUP_MINUTES=60

# Who may download model weights on first use: members (default, members and
# operators), operators, all, or none. Guests get a structured refusal otherwise.
# MODEL_DOWNLOAD_ON_DEMAND=members

# GitHub sign-in. Configured only when all three are set; otherwise the account
# menu says "Sign-in not configured on this server" and everyone is a guest.
# Create an OAuth app at https://github.com/settings/developers with the callback
# URL <OAUTH_REDIRECT_BASE>/v1/auth/github/callback.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# The public origin of the app, as the browser sees it (no trailing slash).
# OAUTH_REDIRECT_BASE=https://demo.example.org

# Tests and E2E only: point sign-in at a fake GitHub instead of github.com.
# GITHUB_OAUTH_BASE=https://github.com
# GITHUB_API_BASE=https://api.github.com

# Who may sign in (comma-separated, case-insensitive), matched against the primary
# verified GitHub email. OPERATOR_EMAILS become operators; ALLOWED_EMAILS and
# addresses in ALLOWED_DOMAINS become members (no analysis limit, jobs and uploads
# kept and shared across devices). Anyone else is told they are not on the
# allowlist and stays a guest. Changes apply to signed-in users on their next request.
# ALLOWED_EMAILS=ana@example.org,bo@example.org
# ALLOWED_DOMAINS=unige.ch
# OPERATOR_EMAILS=ops@example.org

# Behind a reverse proxy: proxies whose X-Forwarded-For is trusted for the client
# IP (comma-separated addresses or CIDRs; "*" trusts everyone). The per-IP guest
# quota counts that IP. Default 127.0.0.1; docker-compose.yml trusts Docker's
# private networks, where the frontend's nginx runs.
# FORWARDED_ALLOW_IPS=127.0.0.1

# Operator settings (/app/settings, GET/PUT /v1/settings) are saved here as
# overrides of the variables above: LLM_PROVIDER_ORDER, LLM_ENABLE_*, the provider
# model variables, MODEL_DOWNLOAD_ON_DEMAND, the allowlists and the guest limits.
# An override wins over this file; .env itself is never written. No secret is
# ever stored there. Default: <DT4LC_CACHE_PATH>/settings.json.
# DT4LC_SETTINGS_PATH=resources/.cache/settings.json

# =============================================================================
# Public demo (docker-compose.demo.yml, docs/DEPLOY_DEMO.md)
# =============================================================================
# On the demo host, these two lines make plain `docker compose up -d` start the
# demo stack (models-init, no published backend port, the rate-limiting nginx).
# COMPOSE_FILE=docker-compose.yml:docker-compose.demo.yml
# COMPOSE_PROFILES=demo

# The demo network's subnet. The backend trusts X-Forwarded-For only from it, and
# nginx takes the client IP from a proxy arriving through it (the Docker gateway).
# Change it only if it clashes with a network on the host.
# DEMO_SUBNET=172.30.60.0/24

# Skip the model downloads of models-init (smoke tests of the demo stack only).
# DEMO_SKIP_MODEL_DOWNLOAD=1
